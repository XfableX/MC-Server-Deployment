pipeline{
    agent any

    stages{
        stage('init'){
            steps{
                sh "echo init"
            }
        }
        stage('validate'){
            steps{
                sh "echo Validating"
            }
            
        }
        stage('build and test packer build') {
            steps {
                sh "/usr/bin/packer build -debug packer.pkr.hcl"
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
