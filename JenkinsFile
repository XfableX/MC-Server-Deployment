
def release = "$env.BRANCH_NAME"

pipeline{
    agent any

    stages{
        stage('init'){
            steps{
                sh "echo init"
            }
        }
        stage('validate'){
            steps{
                sh "echo Validating"
            }
            
        }
        stage('build and test packer build') {
            steps {
                sh "chmod 777 /bin/build-release.py; ./bin/build-release.py --release-name ${release}"
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
