
def release = "$env.BRANCH_NAME"

pipeline{
    agent any

    stages{
        stage('init'){
            steps{
                sh "echo init"
                sh "python -m pip install --user -r requirements.txt"
            }
        }
        stage('validate'){
            steps{
                sh "echo Validating"
            }
            
        }
        stage('build and test packer build') {
            steps {
                sh "echo '$USER'; chmod 777 bin/build-release.py;python ./bin/build-release.py --release-name ${release}"
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}
